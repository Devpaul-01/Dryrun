# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
ADMIN_ALLOWLIST_IPS=            # comma-separated, optional extra layer on top of admin role-gating
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_MOBILE_SCHEME=dryrun://auth-callback

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # API + worker tiers only — never expose to clients
SUPABASE_ANON_KEY=               # client-facing, not used server-side except for reference
SUPABASE_JWT_SECRET=             # used to verify JWTs locally without a round trip, if desired

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers (multi-provider fallback chain; multiple keys per provider supported) ──
CEREBRAS_API_KEY_1=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
OPENAI_API_KEY_1=                # used as a stable, high-quality fallback tier
AI_LIVE_TURN_MODEL_PRIORITY=cerebras,groq,openai
AI_DERIVATIVE_MODEL_PRIORITY=groq,openai,cerebras

# ── Flutterwave ───────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ── Email (transactional) ─────────────────────────────
EMAIL_PROVIDER=console            # console | smtp | resend
EMAIL_FROM=noreply@dryrun.app
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Expo Push ─────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Google OAuth (configured primarily in Supabase Auth dashboard; these are for
#    server-side awareness/redirect construction only) ──
GOOGLE_OAUTH_WEB_REDIRECT_URL=http://localhost:5173/auth/callback
GOOGLE_OAUTH_MOBILE_REDIRECT_SCHEME=dryrun://auth-callback

# ── PostHog (product analytics) ───────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Sentry ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── AV Scan (ClamAV) ───────────────────────────────────
CLAMSCAN_HOST=127.0.0.1
CLAMSCAN_PORT=3310

# ── Feature/product config defaults (mirrored into system_config on first boot) ──
DEFAULT_PAYMENT_ENFORCEMENT_ENABLED=false
DEFAULT_FREE_SESSION_LIMIT_PER_MONTH=4
DEFAULT_SESSION_ATTACHMENT_CAP=5
DEFAULT_AI_DAILY_BUDGET_USD_PER_WORKSPACE=5
