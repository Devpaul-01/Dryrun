{
  "name": "dryrun-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DryRun production backend — AI sales conversation rehearsal platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/jobs/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "morgan": "^1.10.0",
    "zod": "^3.23.8",
    "uuid": "^9.0.1",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "axios": "^1.7.4",
    "posthog-node": "^4.2.0",
    "@sentry/node": "^8.26.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.7.2",
    "clamscan": "^2.2.4",
    "nodemailer": "^6.9.14",
    "resend": "^4.0.0",
    "expo-server-sdk": "^3.10.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
