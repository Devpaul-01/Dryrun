{
  "name": "dryrun-backend",
  "version": "1.0.0",
  "description": "DryRun API and background-worker backend — sales practice/coaching platform for an Expo mobile app.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:worker": "tsx watch jobs/index.ts",
    "dev:all": "tsx watch start-all.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/index.js",
    "start:all": "node dist/start-all.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "echo \"No test suite configured yet\" && exit 0"
  },
  "dependencies": {
    "@sentry/node": "^10.0.0",
    "@supabase/supabase-js": "^2.112.0",
    "axios": "^1.19.0",
    "bullmq": "^5.81.0",
    "clamscan": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "expo-server-sdk": "^3.19.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "mammoth": "^1.12.0",
    "nodemailer": "^7.0.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.0.0",
    "pino-http": "^11.0.0",
    "posthog-node": "^4.0.0",
    "resend": "^4.0.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
