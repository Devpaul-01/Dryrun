# Copy to .env and fill in for local development.
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time
# (Expo's standard public-env convention) — never put secrets here.

# Base URL of the DryRun backend, WITHOUT the /api/v1 suffix
# (src/config/env.ts appends it). See ../backend/.env.example's PORT.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Client-facing Supabase project values — used only for the
# persona-generation-status Realtime channel (architecture doc §4.4, §5).
# Must match the backend's SUPABASE_URL / SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
